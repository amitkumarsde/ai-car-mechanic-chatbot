# Copy to /etc/systemd/system/gunicorn.service on the EC2 server
[Unit]
Description=AI Car Mechanic Django API
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/app/backend
ExecStart=/home/ubuntu/app/backend/venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 2 --timeout 120 --access-logfile -
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
