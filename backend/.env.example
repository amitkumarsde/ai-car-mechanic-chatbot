# Copy this file to .env and fill in real values. Never commit .env.
DEBUG=True
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=

# Free key from https://aistudio.google.com/apikey (chat still works without it, only AI fallback is off)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Leave empty locally. On the server use /var/lib/carbot/db.sqlite3 and /var/lib/carbot/media
SQLITE_PATH=
MEDIA_ROOT=
STATIC_ROOT=

# Set to 1 on the server because nginx sits in front of Django
NUM_PROXIES=
SECURE_SSL_REDIRECT=True
